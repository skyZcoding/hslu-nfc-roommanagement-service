# Settings for docker-compose.yml. Copy this file to .env (git-ignored) and adjust it:
#
#   cp .env.example .env

# The database that the compose file creates. These values are only applied when the database volume is
# created, so changing them later has no effect on an existing database (`docker compose down -v` resets it).
POSTGRES_USER=roommanagement
POSTGRES_DB=roommanagement
# Choose your own. It is placed in a connection string, so avoid ';' and '=' in it.
POSTGRES_PASSWORD=change-me

# Where the API is published on this machine. The API has no authentication yet, so by default it only listens
# on localhost. Set API_BIND=0.0.0.0 to reach it from other machines, for example from the NFC readers.
API_BIND=127.0.0.1
API_PORT=8080

# Production (default) or Development. Development also serves the Swagger UI at /swagger.
#ASPNETCORE_ENVIRONMENT=Development
